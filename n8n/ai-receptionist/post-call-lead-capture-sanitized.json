    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst sanitized = { ...item };\nsanitized.caller_email = (item.caller_email && item.caller_email.trim() !== '') ? item.caller_email.trim() : null;\nsanitized.caller_name = (item.caller_name && item.caller_name.trim() !== '') ? item.caller_name.trim() : 'Unknown Caller';\nsanitized.caller_phone = (item.caller_phone && String(item.caller_phone).trim() !== '') ? String(item.caller_phone).trim() : null;\nsanitized.service_requested = (item.service_requested && item.service_requested.trim() !== '') ? item.service_requested : null;\nsanitized.stylist_requested = (item.stylist_requested && item.stylist_requested.trim() !== '') ? item.stylist_requested : 'Any';\nsanitized.call_intent = (item.call_intent && item.call_intent.trim() !== '') ? item.call_intent : 'other';\nsanitized.call_outcome = (item.call_outcome && item.call_outcome.trim() !== '') ? item.call_outcome : 'no_outcome';\nreturn [{ json: sanitized }];"
      },
