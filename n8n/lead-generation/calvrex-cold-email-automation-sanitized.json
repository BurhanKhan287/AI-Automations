    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n  const status = (lead.status || '').trim();\n  const sentDate = lead.sent_date;\n  const company = lead.company || '';\n\n  if (status === 'replied' || status === 'follow_up_2') continue;\n  if (!lead.email) continue;\n\n  let daysSince = 999;\n  if (sentDate) {\n    const sent = new Date(sentDate);\n    daysSince = Math.floor((now - sent) / (1000 * 60 * 60 * 24));\n  }\n\n  let category, emailSubject, emailBody, newStatus;\n\n  if (!status || status === '') {\n    category = 'cold_email';\n    emailSubject = 'Quick question, ' + company;\n    emailBody = 'Hey ' + company + ',\\n\\nDo you ever miss calls when your team is busy with a client?\\n\\nWe built an AI receptionist that answers every call 24/7 \\u2014 books appointments, answers questions, and handles enquiries automatically. Salons using it are capturing 30-40% more bookings from calls they used to miss.\\n\\nWould it make sense to show you a quick demo this week?\\n\\nAsher\\nCalvrex\\nhttps://calvrex.com\\n\\nP.S. Not relevant? Just reply and I\\'ll remove you.';\n    newStatus = 'sent';\n  } else if (status === 'sent' && daysSince >= 3) {\n    category = 'follow_up_1';\n    emailSubject = 'Re: Quick question, ' + company;\n    emailBody = 'Hey ' + company + ',\\n\\nJust following up \\u2014 wanted to make sure this didn\\'t get buried.\\n\\nMissed calls are one of the biggest hidden revenue leaks for salons. Our AI receptionist fixes that automatically.\\n\\nWorth a 10-min chat?\\n\\nAsher\\nCalvrex';\n    newStatus = 'follow_up_1';\n  } else if (status === 'follow_up_1' && daysSince >= 5) {\n    category = 'follow_up_2';\n    emailSubject = 'Re: Quick question, ' + company;\n    emailBody = 'Hey ' + company + ',\\n\\nLast one from me \\u2014 if missed calls aren\\'t a priority right now, totally understand.\\n\\nIf things change and you want to see how the AI receptionist works, just reply and I\\'ll set up a demo.\\n\\nAsher\\nCalvrex';\n    newStatus = 'follow_up_2';\n  } else {\n    continue;\n  }\n\n  results.push({\n    json: {\n      ...lead,\n      category,\n      email_subject: emailSubject,\n      email_body: emailBody,\n      new_status: newStatus\n    }\n  });\n}\n\nreturn results;"
      },
