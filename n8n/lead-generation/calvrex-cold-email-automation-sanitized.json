    {
      "parameters": {
        "jsCode": "const bookingPlatforms = ['vagaro', 'booksy', 'fresha', 'mindbody', 'acuity', 'schedulicity', 'booker', 'salonbiz', 'styleseat', 'squareup', 'square.site', 'calendly', 'getsquire', 'boulevard', 'glossgenius', 'zoca'];\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const place = item.json;\n  const website = (place.website || '').toLowerCase();\n\n  if (bookingPlatforms.some(p => website.includes(p))) continue;\n  if (!place.phone) continue;\n\n  const name = place.title || '';\n\n  results.push({\n    json: {\n      first_name: name,\n      email: '',\n      company: name,\n      industry: 'salon',\n      phone: place.phone || '',\n      website: place.website || '',\n      status: '',\n      sent_date: ''\n    }\n  });\n}\n\nreturn results;"
      },
